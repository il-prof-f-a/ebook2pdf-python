{
  "manifest_version": 3,
  "name": "Ebook2PDF",
  "version": "0.4.0",
  "description": "Cattura pagine visibili di documenti online autorizzati e le raccoglie in un PDF, con OCR locale opzionale.",
  "permissions": [
    "activeTab",
    "tabs",
    "sidePanel",
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Apri Ebook2PDF"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}